# .env.exempel – kopieras till .env av tools/forsta-start.sh, som slumpar fram de tomma hemligheterna nedan.
# Portar och låsta taggar (image-versioner) är byggkontraktet: ändra dem inte utan att veta varför.
# =====================================================================
# SVADA PoC – central konfiguration
# =====================================================================
# Enda källan för PORTAR (portkartan nedan) och LÅSTA IMAGE-TAGGAR
# (regeln om låsta taggar: inga rörliga taggar). Denna fil är spårad i git eftersom den
# utgör byggkontraktet. Endast lokala dummy-lösenord för PoC – lägg
# aldrig riktiga hemligheter här (använd .env.local, se .gitignore).
#
# OBS: image-taggarna nedan är förvalda och LÅSES – varje
# komponent verifieras: att dess tag faktiskt drar och startar.
# Versionsbyten dokumenteras vid respektive tagg.
# =====================================================================

# ---------- Parallell miljö (publik demo, gren publik-demo) ----------
# Prefix för compose-projekt, containrar, images, delat nät och delad
# volym. Originalet (gren main) kör utan variabeln och får då "svada".
# Två stackar kan därmed köra samtidigt på samma maskin.
SVADA_PREFIX=svadamini
# Demons version (ÅÅÅÅ.MM.DD-N): sätts HÄR och visas i sidfoten, i /api/status och på /nyheter. Ny version vid varje ändring en besökare kan märka;
# översta posten i services/dashboard/nyheter.py ska ha samma värde (provet tests/version_enhet.py).
SVADA_VERSION=2026.10.23-11
# Portkartan nedan är FÖRSKJUTEN mot originalet så att
# ingen värdport krockar:  <10000 -> +30000,  DHI 191NN -> 391NN,
# Stad 291NN -> 393NN. Containerportarna (höger sida i compose) är oförändrade.

# ---------- Publik ingång (Caddy, publik demo) ----------
# Besökaren når kedjan ENDAST via Caddy, med ett värdnamn per publik roll.
# Allt styrs av DEMO_DOMAN – att flytta demon är att byta den raden (och
# schema/port nedan). Lokalt (Mac) pekar *.localhost automatiskt på den
# egna datorn; på en server sätts:
#   DEMO_DOMAN=svada-demo.example.org  DEMO_URL_SCHEMA=https  DEMO_URL_PORT=
#   CADDY_ADRESS_PREFIX=  CADDY_HTTP_PORT=80  CADDY_HTTPS_PORT=443
#   CADDY_BIND_IP=0.0.0.0  CADDY_BIND_IP6=::  INGANG_IPV6=true
#   DEMO_KAKA_SECURE="; Secure"
DEMO_DOMAN=svada-demo.localhost
DEMO_URL_SCHEMA=http
DEMO_URL_PORT=:38080
# Tomt = Caddy hämtar TLS-certifikat själv (Let's Encrypt). "http://" = bara
# HTTP (lokalt; *.localhost kan inte få publika certifikat).
CADDY_ADRESS_PREFIX=http://
CADDY_HTTP_PORT=38080
# Lokalt 127.0.0.1 (ingen utanför Macen); på servern 0.0.0.0.
CADDY_BIND_IP=127.0.0.1
# Samma för IPv6 (Docker binder en uttrycklig IPv4-adress bara på IPv4):
# lokalt ::1, på servern :: (annars når AAAA-posterna en stängd port).
CADDY_BIND_IP6=::1
# IPv6 på Caddys Docker-nät, så att IPv6-besökare behåller sin riktiga
# adress (annars delar alla en hastighetsgräns). Servern true, lokalt false.
INGANG_IPV6=false
CADDY_HTTPS_PORT=38443
# Caddy byggs med ratelimit-tillägget (services/caddy/Dockerfile, K3/K4).
# Basbilderna och plugin-taggen är låsta (regeln om låsta taggar).
CADDY_IMAGE=caddy:2.11.7-alpine
CADDY_BUILDER_IMAGE=caddy:2.11.7-builder-alpine
CADDY_RATELIMIT_VERSION=v0.1.0
# Hastighetsbegränsning per klient-IP (ratelimit-tillägget). POST-knappar
# och tunga temporala frågor är de dyra anropen; läsning är generös.
RATE_SKRIV_FONSTER=1m
RATE_SKRIV_ANTAL=20
# Händelserna från sidan (statistik) har en egen gräns, så att de inte äter knapparnas.
RATE_HANDELSE_FONSTER=1m
RATE_HANDELSE_ANTAL=240
# Egna adresser som statistiken inte ska räkna (kapade /24-adresser, CIDR, kommaseparerade). Tomt = alla räknas.
STATISTIK_UTESLUT=
RATE_TIDSSERIE_FONSTER=1m
RATE_TIDSSERIE_ANTAL=30
# Lösenordsgrinden: hela demon bakom ett gemensamt lösenord tills projektet
# är redo att kommunicera den (Caddyfile, snippet "inloggning"). Lösenordet
# och kakans token är HEMLIGA och ligger INTE här, utan i .demo-losenord
# resp. .demo-inloggning.env (ignoreras av git), skapade av
# tools/nytt-demo-losenord.sh. Här bara det som inte är hemligt:
# Standardanvändarnamn – skriptet kopierar det till .demo-inloggning.env,
# eller tar det du anger med --valj.
DEMO_ANVANDARE=svada
# Lösenordsgrinden (engelskt namn och värden, så att konfigurationen är lätt att använda internationellt): on (standard, grinden gäller) eller
# off (demon är öppen för alla). Sätt inte raden här om du inte vill ändra läget; standardvärdet är on. Exempel: DEMO_GATE=off

# Kakans livslängd i sekunder (30 dygn): besökaren slipper logga in igen.
DEMO_KAKA_MAXALDER=2592000
# Tomt lokalt (http – en Secure-kaka skulle inte sparas). På servern (https):
#   DEMO_KAKA_SECURE="; Secure"
DEMO_KAKA_SECURE=
# Lösenordsförsök per klient-IP. 30/min räcker för ett mötesrum bakom en
# gemensam IP och gör gissning meningslöst (lösenordet har ~80 bitar).
RATE_INLOGG_FONSTER=1m
RATE_INLOGG_ANTAL=30
# Adress som ALLA övriga värdportar binds till. Lokalt 127.0.0.1: bara den
# egna maskinen når dem (kontrollrummet och Caddy går via
# host.docker.internal, vilket Docker Desktop tillåter). PÅ LINUX (Docker
# Engine) måste den vara Docker-bryggans adress (vanligen 172.17.0.1):
# tools/forsta-start.sh sätter den åt dig. Originalet binder 0.0.0.0
# (standardvärdet i compose).
VARD_BIND_IP=127.0.0.1
# De publika adresserna, härledda ur ovanstående. Används i katalogposten
# (accessURL), publik-vy, stad-gateway, skördarna och kontrollrummet.
PUBLIK_URL_KONTROLLRUM=${DEMO_URL_SCHEMA}://${DEMO_DOMAN}${DEMO_URL_PORT}
PUBLIK_URL_CIP=${DEMO_URL_SCHEMA}://cip.${DEMO_DOMAN}${DEMO_URL_PORT}
PUBLIK_URL_TIDSSERIE=${DEMO_URL_SCHEMA}://tidsserie.${DEMO_DOMAN}${DEMO_URL_PORT}
PUBLIK_URL_BRUNNAR=${DEMO_URL_SCHEMA}://brunnar.${DEMO_DOMAN}${DEMO_URL_PORT}

# ---------- Automatisk start ----------
# Omstartspolicy för alla tjänster. "no" lokalt: INGET startar av sig
# självt när Docker Desktop startar. En automatisk start kör inte
# engångsjobben (registrera-edc m.fl.) och tar inte upp identitetskedjan i
# ordning – stacken ser frisk ut (13/13) men DSP svarar 401. Starta alltid
# med starta-demo.sh. På servern: unless-stopped (demon ska överleva en
# omstart av Docker; aterstall-demo.sh körs av svada-aterstall.service när Docker
# startat, och varje natt kl 04:00 av cron).
SVADA_RESTART=no
# Kontrollrummets variant: extern = publik demo (inga portnummer, inga interna
# hänvisningar). Intern är standard i main.
DEMO_VARIANT=extern
# Klockslaget (serverns TZ) för den nattliga återställningen; visas som nedräkning. Tomt lokalt: ingen nedräkning.
# På servern: 04:00 (samma som cron-raden).
DEMO_ATERSTALL_KL=

# ---------- Hastighet / demo ----------

# ---------- Resursstrategi (bindande) ----------
EDC_JVM_XMX=-Xmx512m        # JVM-heaptak per EDC-connector
MONGO_WT_CACHE_GB=0.25      # WiredTiger-cache per Mongo-instans
TZ=Europe/Stockholm

# =====================================================================
# PORTKARTA
# =====================================================================
# SÄKERHET (granskning 2026-08-08):
# portarna nedan publiceras utan lyssnaradress, dvs. Docker binder dem
# till 0.0.0.0 inne i WSL-burken. Det är OK så länge WSL kör i
# standardläget NAT – Windows släpper då bara in trafik från den egna
# maskinen. Kör WSL däremot i `networkingMode=mirrored` ligger hela
# kedjan öppen mot kontorsnätet, inklusive Orion-LD på 1026 som svarar
# UTAN lösenord och innehåller Distribution A:s fullständiga brunns-GIS.
#
# Bindningen kan inte flyttas till 127.0.0.1 utan att dashboarden och
# FAIR-tjänsten slutar fungera: de observerar kedjan utifrån via
# host.docker.internal (services/dashboard/kallor.py). Kontrollen
# ligger därför i tests/verify_ap0.sh ("Extra: WSL-nätverksläge"), som
# fäller mirrored-läget.

# ----- Org DHI (provider) -----
FCF_SIM_PORT=38050           # FCF-simulatorns dataplans-API
EDC_PROVIDER_DSP_PORT=39194        # DSP-protokoll (public)
EDC_PROVIDER_MGMT_PORT=39193       # Management-API (KoV-godkännande A)
EDC_PROVIDER_CONTROL_PORT=39192    # Control-API (internt)
EDC_PROVIDER_DEFAULT_PORT=39191    # Default/observability
IDENTITY_HUB_DHI_DEFAULT_PORT=39195      # IdentityHub DHI: hälsa (/api)
IDENTITY_HUB_DHI_IDENTITY_PORT=39196     # IdentityHub DHI: /api/identity (admin)
IDENTITY_HUB_DHI_DID_PORT=39197          # IdentityHub DHI: did:web-dokument (publikt)
IDENTITY_HUB_DHI_CREDENTIALS_PORT=39198  # IdentityHub DHI: /api/credentials (DCP)

# ----- Org Göteborgs Stad (consumer) -----
EDC_CONSUMER_DSP_PORT=39394
EDC_CONSUMER_MGMT_PORT=39393
EDC_CONSUMER_CONTROL_PORT=39392
EDC_CONSUMER_DEFAULT_PORT=39391
IDENTITY_HUB_STAD_DEFAULT_PORT=39395      # IdentityHub Stad: hälsa (/api)
IDENTITY_HUB_STAD_IDENTITY_PORT=39396     # IdentityHub Stad: /api/identity (admin)
IDENTITY_HUB_STAD_DID_PORT=39397          # IdentityHub Stad: did:web-dokument (publikt)
IDENTITY_HUB_STAD_CREDENTIALS_PORT=39398  # IdentityHub Stad: /api/credentials (DCP)
INGEST_PORT=38060            # ingest-service
ORION_STAD_PORT=32026        # Stadens CIP utåt = stad-gateway (G22).
                            # orion-stad själv publicerar INGEN port och nås
                            # bara från stad-internal – gatewayen är enda
                            # vägen in utifrån.
MINTAKA_PORT=38083           # Mintaka temporal API
PUBLIK_VY_PORT=38085         # Stadens publika vy av Distribution B (G9)

# ----- Nationellt / EU / tvärgående -----
DASHBOARD_PORT=38800         # Kontrollrum

# =====================================================================
# LÅSTA IMAGE-TAGGAR (inga rörliga taggar)
# =====================================================================
# ----- Stadens dataplan -----
ORION_LD_IMAGE=fiware/orion-ld:1.12.0
# MongoDB 7.0: Orion-LD startas med -mongocOnly (compose.stad.yml), som stänger av den gamla C++-drivrutinen
# (OP_QUERY, borttaget i MongoDB 5.1); utan flaggan stoppar Orion-LD mot MongoDB 5.1 eller nyare. 7.0 stöds till 2027-08.
# MongoDB 8.0.34 vägrar starta på Linux-kärna 6.19 eller nyare, så 8.0 är inte ett val än.
MONGO_IMAGE=mongo:7.0.45
MINTAKA_IMAGE=fiware/mintaka:0.7.0
# TRoE kräver PostGIS (Orion-LD kör CREATE EXTENSION postgis). timescaledb-ha, -oss-varianten: PostgreSQL 17 med PostGIS 3.6 och
# TimescaleDB 2.31 under Apache-2.0 (inga delar under Timescale License), finns för amd64 och arm64. Imagen är stor (ca 2,6 GB).
TIMESCALE_IMAGE=timescale/timescaledb-ha:pg17.11-ts2.31.0-oss

# ----- TRoE/Timescale-konto (lokal PoC) -----
TROE_DB_USER=orion
TROE_DB_NAME=orion

# ----- Sensorledet -----
# Liten image med curl (+ jq) för engångsjobbet som provisionerar IoT Agenten.
CURL_IMAGE=alpine/curl:8.22.0
# MQTT-klienten i sensor-simulatorns bygge (låst, regeln om låsta taggar).

# ----- IoT Agent-provisionering -----
# API-nyckeln ingår i MQTT-topicen: /<apikey>/<device_id>/attrs
# Entiteten som mätvärdena skrivs till i orion-dhi (samma id som brunnen
# har i stadens CIP, se stadens CIP) och dess typ.
IOTA_ENTITY_ID=urn:ngsi-ld:SewerOverflowWeir:SSO1_01-4526
# FIWARE-tenant/sökväg – obligatoriska headers i provisionerings-API:t.
# VERIFIERAT: tom fiware-service ger HTTP 400 från IoT Agenten, så tenant
# KAN inte undvikas. Agenten vidarebefordrar den som NGSILD-Tenant till
# Orion-LD => entiteterna ligger i tenanten "dhi" och NGSI-LD-frågor mot
# orion-dhi måste skicka headern "NGSILD-Tenant: dhi".
# @context som IoT Agenten anger i Link-headern mot Orion-LD.

# ----- Sensor-simulatorns uppspelning -----

# ----- FCF-simulatorn (fcf-sim, profil dhi-fcf) -----
# Pythonberoenden låsta enligt regeln om låsta taggar (byggs in i imagen som ARG).
FASTAPI_VERSION=0.158.1
UVICORN_VERSION=0.54.0
# Daglig batch "kl 05" – komprimerad: ETT modellerat dygn per intervall.
FCF_BATCH_INTERVAL_S=600    # 600 s = 10 min per modellerat dygn
FCF_BATCH_HOUR=5            # batchklockan (kl 05 dygnet efter det modellerade)
FCF_BATCH_RETENTION=10      # antal batchar som sparas i minnet
FCF_POLL_INTERVAL_S=2       # pollning av orion-dhi (samma takt som SIM_INTERVAL_S)
# Vänta så länge på mätvärden före batch 1. Batch 1 SKA vila på riktiga
# mätvärden (verify_ap3.sh 3.x kollar sensorbrunnens dataSource). Vid en
# kallstart startar orion-dhi, iot-agent, mosquitto och sensor-simulatorn
# SAMTIDIGT som fcf-sim, och devicen provisioneras först därefter – 45 s
# räckte inte och batch 1 föll tillbaka på reservmönstret. Väntan bryts så
# snart FCF_MIN_SAMPLES punkter finns (normalt ~30 s), taket slår bara till
# när mätkedjan är trasig.
FCF_WARMUP_S=300
# GOTCHA: tomt värde MÅSTE stå utan efterföljande kommentar – Compose tar
# annars med "# ..." som en del av värdet.
# Tomt = första modellerade dygnet hämtas ur mätseriens observedAt.
FCF_START_DAY=
# Felinjektionsläget – AV som default (verifieringens testfall 3.8). Slås på
# via env ELLER i drift via POST /felinjektion.
FCF_FAULT_SCHEMA_DRIFT=false    # döper om fält (modellversionsdrift)
FCF_FAULT_MISSING_FIELDS=false  # utelämnar avtalade parametrar
FCF_FAULT_GIS_IN_B=false        # AVTALSBROTT: brunns-GIS kvar i Distribution B

# ----- EDC (egen image byggs på denna bas) -----
EDC_BASE_IMAGE=eclipse-temurin:17.0.20.1_1-jre
# Byggsteget (multi-stage): Gradle + JDK 17. Shadow-pluginet 9.6.0 kräver Gradle 9.x;
# Eclipse EDC:s Samples-repo kör Gradle 9.6.1 i sin wrapper, och 9.8.2 (senaste 9.x
# 2026-10) bygger våra connectorer utan ändringar.
EDC_GRADLE_IMAGE=gradle:9.8.2-jdk17
# Eclipse EDC-versionen. Låst enligt regeln om låsta taggar och vald för att den är
# exakt den version eclipse-edc/Samples pinnar (gradle/libs.versions.toml),
# dvs. connector-bygget nedan följer den officiella samples-vägen.
# DSP-versionen som följer med 0.17.0 är 2025-1 (sökväg /protocol/2025-1).
EDC_VERSION=0.17.0
EDC_DSP_VERSION=2025-1
# Deltagar-ID:n i dataspacet (DSP counterPartyId). Med verifierbar DCP-identitet:
# detta
# MÅSTE vara samma DID-sträng som edc.participant.id i edc/konfig/*.properties
# (DidConfigProvider i decentralized-claims-core konsulterar ALDRIG
# edc.participant.did som fallback om edc.participant.id är satt till NÅGOT
# värde) - därför did:web-strängar, inte
# "dhi"/"stad" som tidigare. De KORTA namnen "dhi"/"stad" lever
# kvar som semantiska deltagarnamn i SVADA_PARTICIPANT_ID_DHI/_STAD nedan -
# det är DE värdena som hamnar i den verifierade VC:ns "participantId"-claim
# och som ODRL-funktionen svada:deltagare (DeltagareFunktion.java) jämför
# mot, helt oberoende av vilken DID-sträng som används för DSP-korrelation.
EDC_PROVIDER_ID=did:web:identity-hub-dhi%3A19197
EDC_CONSUMER_ID=did:web:identity-hub-stad%3A29197
# Dataplanets publika port (EDC:s "public" web context). Ligger MEDVETET
# utanför portkartans 19191-19194/29191-29194 på VÄRDEN – den publiceras
# inte alls, utan används enbart container-till-container i tidsserietransferen.
EDC_PROVIDER_PUBLIC_PORT=19291
EDC_CONSUMER_PUBLIC_PORT=29291
# Assetet som registreras för katalog och förhandling: Distribution B mot fcf-sim.
EDC_ASSET_B_ID=modellerad-bradddata-b
EDC_ASSET_B_URL=http://fcf-sim:8050/distributions/b/latest
# Assetet som registreras för KoV-gaten: Distribution A (K1R1T1, non-public).
# Egen asset, egen policy och egen kontraktsdefinition – aldrig B:s.
EDC_ASSET_A_ID=modellerad-bradddata-a
EDC_ASSET_A_URL=http://fcf-sim:8050/distributions/a/latest

# ----- Ingest-service (stadens mottagning av transfern) -----
# Engångsauktorisationens livslängd. Kort med flit: token växlas mot ett
# kontraktsavtal strax innan transfern startas och konsumeras vid pushen.
INGEST_TOKEN_TTL_S=600
# Antal leveranser/avvisningar som sparas i minnet (kvittologgen).
INGEST_LOG_RETENTION=50
# Transfertypen som consumern begär. HttpData-PUSH = providerns dataplan
# hämtar ur fcf-sim och PUSHAR till stadens ingest (enligt
# komponent 6: "koordinerar transfer (HTTP-push till stadens ingest)").
EDC_TRANSFER_TYPE=HttpData-PUSH
# Stadens mottagningsendpoint sedd från providerns dataplan (dsp-public).
INGEST_PUSH_URL=http://ingest-service:8060/ingest

# ----- CKAN-stacken -----
# Versionsbyte: den ursprungliga
# taggen ckan/ckan-postgres-db:2.11 FINNS INTE på Docker Hub – ckan-docker
# bygger den databasimagen lokalt ur sitt eget repo. PoC:en kör utan CKAN:s
# datastore-tillägg (katalogen lagrar bara metadata, aldrig data – ingen datakopia), och då räcker en ren Postgres med databasen "ckan".
# Tilläggen som byggs in i CKAN-imagen (ckan/Dockerfile). Låsta versioner.

# ----- CKAN-konto och katalogidentitet -----
# OBS: värden med blanksteg/parenteser MÅSTE citeras. Compose klarar sig
# utan, men verifieringsskripten källar in .env med "set -a; . ./.env" och
# bash tolkar då parenteser som syntaxfel.
# Sysadmin som prerun.py skapar i CKAN. Endast lokal PoC.
# CKAN-organisationen som äger datamängden (Data Holder = Intraservice).
# Katalogens namn i DCAT-AP-utdatat (dcterms:title/description på dcat:Catalog).

# ----- Solr-heap -----
# EXPLICIT tak. -XX:MaxRAMPercentage får INTE användas: JVM:er i den här
# miljön läser inte cgroup v2-gränsen under WSL2 och skulle ta 25 % av
# värdens 20 GiB.

# ----- Katalog-publicering (registrering + SHACL) -----
# Pythonberoenden låsta enligt regeln om låsta taggar (byggs in i imagen som ARG).
# Datamängdens slug i CKAN – används av registreringen, verifieringen och
# skördarna i skördarsteget.
# Tidsfönstrets start för den publika vyn och för Distribution B:s
# accessURL. NGSI-LD Temporal API KRÄVER timerel+timeAt – utan dem svarar
# Mintaka "Invalid time relation." (gapanalys G9). Ett tidigt datum ger
# "hela historiken".
PUBLIK_VY_TIMEAT=2020-01-01T00:00:00Z

# ----- Åtgärd G22: stad-gateway (åtkomstkontroll framför CIP:en) -----
# Distribution A är non-public (K1R1T1) och bär brunnarnas fulla GIS.
# Fram till G22 var den märkningen bara en etikett i katalogen: orion-stad
# låg oskyddad på 2026. Gatewayen verkställer den nu.
#
# Drifttoken för stadens EGNA komponenter (dashboard, FAIR-lagret,
# verifieringsskripten). Externa konsumenter använder inte den här utan
# växlar sitt contractAgreementId mot en token på POST /auktorisation.
# MEDVETEN FÖRENKLING – ersätts av verifierbar identitet: en delad hemlighet i .env blir då
# verifierbara identiteter (Keycloak / DCP-attest).
STAD_GATEWAY_DRIFT_TOKEN=
# Livslängd på en KoV-token. En timme: längre än en demo, kortare än ett dygn.
STAD_GATEWAY_TOKEN_TTL_S=3600
STAD_GATEWAY_TIMEOUT_S=30

# --- Nyckelskyddade management-API:er: bindande miniminivå ------------
# docs/koncept/C1-identitet.md. Delad nyckel per part (INTE en verifierbar
# identitet - det är Fas 2) på EDC:s management-API, plus ett namngivet
# KoV-rollnamn som loggas med varje beslut. Ersätts av verifierbara attest
# i Fas 2.
EDC_PROVIDER_MGMT_KEY=
# Skrivskyddad nyckel för avtalsstatus (det enda staden får läsa hos DHI; ersätter management-nyckeln)
# Avtalsstatusens port hos edc-provider (bara internt över dsp-public, publiceras aldrig). Det är containerns
# egen port 19195, inte identity-hub-dhis (som är en annan container). Numret står också i
# edc/konfig/provider.properties (web.http.avtalsstatus.port) och KovGateExtension.java.
EDC_PROVIDER_STATUS_PORT=19195
EDC_PROVIDER_STATUS_KEY=
# Samordningsrollens nyckel för att återkalla medlems- och deltagarintyg (Svadas utfärdare, /svada-status)
SVADA_STATUS_ADMIN_KEY=
EDC_CONSUMER_MGMT_KEY=
SVADA_KOV_ROLLINNEHAVARE="Kretslopp och Vatten – rättighetsinnehavare (dataägare)"
# Delad demo med en egen vy per besökare (grenen svada-mini-sessioner): ett avslag får INTE häva andras avtal. true = PoC-regeln för avtalsgiltighet och hävning
# (standard i grenen svada-mini); false = avstängd. Provet 10.4 i verify_ap10.sh följer variabeln.
SVADA_KOV_AVSLAG_HAVARTIDIGARE=false
# Egen vy per besökare (sessionskaka): ja/nej. Gäller bara anrop via Caddy i den externa varianten.
DASH_SESSIONER=ja

# --- Verifierbar DCP-identitet (Eclipse EDC IdentityHub) ---------------
# Ersätter successivt
# ovanstående delade nyckel med en riktig, verifierbar DCP-identitet
# (verifiable credentials, DID:et did:web) – en IdentityHub-instans per part.
#
# DID-METOD: did:web, INTE did:key. Spiken (2026-09-01) verifierade att EDC
# 0.17.0 saknar allt did:key-stöd (ingen identity-did-key-modul, ingen
# publisher registrerad för DID_KEY_METHOD) – did:web är den enda DID-metod
# EDC faktiskt bygger, publicerar och löser upp åt en
# DID-strängen räknas ut av IdentityHub självt utifrån den URL
# did-porten nedan nås på (DidWebParser: "http://<host>:<port>/<path>" ->
# "did:web:<host>%3A<port>:<path>") - se registreringssteget (steg 3).
IDENTITY_HUB_VERSION=v0.17.0
# Git-tagg (med v-prefix - IdentityHubs eget taggformat), inte ett
# Maven-koordinatnummer: launcher-modulen publiceras inte till Maven
# Central utan byggs ur källkod, se identity-hub/Dockerfile.
IDENTITY_HUB_JVM_XMX=-Xmx384m

# STS-kontexten (den inbäddade Secure Token Service:n) anropas ENDAST av den egna partens edc-connector, aldrig av
# motparten eller utifrån - därför MEDVETET utanför portkartan ovan och
# INTE publicerad mot värden, exakt samma mönster som
# EDC_PROVIDER_PUBLIC_PORT/EDC_CONSUMER_PUBLIC_PORT).
IDENTITY_HUB_DHI_STS_PORT=19199
# Stadens
# STS publiceras ÄNDÅ mot host, till skillnad från DHI:s ovan. Orsak:
# services/dashboard (kallor.py, kov_beslut) kan av design INTE nås av
# eller nå de interna org-näten (compose.kontrollrum.yml: "Kontrollrummets
# eget nät: det behöver INGET org-nät") – för att dashboardens
# KoV-godkänn/avslå-knappar ska kunna hämta ett self-issued DCP-token
# (samma flöde som tests/lib.sh:s hamta_kov_token()) måste den nå STS:en
# via host.docker.internal, precis som den redan når management-API:erna.
# STS kräver fortfarande giltig client_secret för att mynta ett
# användbart token, så detta är samma förtroendemodell (host-nätet är en
# betrodd operatörsgräns, appnivåhemligheten är det faktiska skyddet) som
# management-nycklarna redan bygger på – samma beslut som ovan.
IDENTITY_HUB_STAD_STS_PORT=39399

# --- Utfärdare med rätt mandat: Svadas utfärdare (DSGA 0.1), compose.dsga.yml ---
# Egen IdentityHub-instans för samordningsrollen. Utfärdar
# SvadaParticipantCredential och SvadaMembershipCredential åt DHI och Staden.
# Utfärdar INGA rollintyg: Staden intygar själv sin rollfördelning (KoV är
# rättighetsinnehavare), DHI sitt eget. Portserien 395xx på värden mot 4919x i
# containern (DHI 391xx/191xx, Staden 393xx/291xx). STS-porten (49199) publiceras
# inte: utfärdaren är ingen deltagare och har ingen connector.
# MEDVETEN FÖRENKLING – simulerar DSGA 0.1:s tillitstjänst. Inga intyg är
# förankrade i eIDAS. Ingen återkallelse (status list). In-memory-lagring.
IDENTITY_HUB_SVADA_DEFAULT_PORT=39595      # IdentityHub Svada: hälsa (/api)
IDENTITY_HUB_SVADA_IDENTITY_PORT=39596     # IdentityHub Svada: /api/identity (admin)
IDENTITY_HUB_SVADA_DID_PORT=39597          # IdentityHub Svada: did:web-dokument (publikt)
IDENTITY_HUB_SVADA_CREDENTIALS_PORT=39598  # IdentityHub Svada: /api/credentials
SVADA_PARTICIPANT_ID_SVADA=svada
SVADA_PARTICIPANT_DID_SVADA=did:web:identity-hub-svada%3A49197

# Deltagar-ID:n och did:web-DID:n för respektive IdentityHub-instans, läst
# av SvadaParticipantBootstrapExtension (identity-hub/, se den filen för
# den fulla motiveringen till varför IdentityHub behöver en egen
# bootstrap-extension över huvud taget). DID-strängarna nedan är IDENTISKA
# med EDC_PROVIDER_ID/EDC_CONSUMER_ID ovan (samma part, samma DID - sedan
# verifierbar DCP-identitet, se kommentaren vid EDC_PROVIDER_ID). De KORTA ID:na (dhi/stad) är
# separata: de blir "participantId"-claimet i respektive parts VC (se
# SvadaParticipantBootstrapExtension "ATTEST-UTFÄRDANDE" nedan) och är vad
# se.goteborg.svada.edc.dcp.SvadaParticipantIdExtractionFunction sätter som
# ParticipantAgent-identitet efter DCP-verifiering - dvs. det är DE här
# korta namnen ODRL-policyn (svada:deltagare eq "stad") jämför mot, inte
# DID-strängarna. DID-strängen är IdentityHubs egen DidWebParser-beräkning
# (did:web:<värdnamn>%3A<port>) för den DID-
# publiceringsport motparten faktiskt når containern på över dsp-public -
# INTE beräknad automatiskt, den måste anges (ParticipantManifest#did).
SVADA_PARTICIPANT_ID_DHI=dhi
SVADA_PARTICIPANT_DID_DHI=did:web:identity-hub-dhi%3A19197
SVADA_PARTICIPANT_ID_STAD=stad
SVADA_PARTICIPANT_DID_STAD=did:web:identity-hub-stad%3A29197

# CredentialService-URL:en respektive IdentityHub-instans publicerar i sitt
# eget DID-dokument (saknades vid första verify_
# ap4a.sh-körningen - gav ett generiskt 401 på DSP-katalogfrågan eftersom
# motpartens edc-connector inte hittade var den skulle begära en Verifiable
# Presentation). Byggd av containerns egen WEB_HTTP_CREDENTIALS_PORT/_PATH
# (19198/29198, /api/credentials) plus PresentationApiControllers fasta
# sökväg (/v1/participants/<kort-id>/presentations), MINUS sista "/query"-
# segmentet som anropande sidans DefaultCredentialServiceClient (uppströms)
# själv lägger på - se SvadaParticipantBootstrapExtension.java,
# INSTALLNING_CREDENTIAL_SERVICE_URL.
SVADA_CREDENTIAL_SERVICE_URL_DHI=http://identity-hub-dhi:19198/api/credentials/v1/participants/dhi
SVADA_CREDENTIAL_SERVICE_URL_STAD=http://identity-hub-stad:29198/api/credentials/v1/participants/stad

# STS-klienthemligheter: delad hemlighet via .env, samma
# mönster som management-API-nyckeln.  IdentityHub-sidans
# SvadaParticipantBootstrapExtension skriver över den slumpmässigt
# genererade STS-klienthemligheten med detta LITERALA värde (via
# StsAccountService#updateSecret); edc-sidans SvadaDcpIdentityExtension
# seedar SAMMA literala värde i sin egen, separata vault - ingen runtime-
# handshake behövs eftersom båda parter läser samma .env-värde via sitt
# eget compose-styrda miljövariabelnamn (SVADA_STS_CLIENT_SECRET, scopat
# per part i compose.dhi.yml/compose.stad.yml). Genererade med
# `openssl rand -hex 16`; byt ut om PoC:en någonsin lämnar en sluten miljö.
SVADA_STS_CLIENT_SECRET_DHI=
SVADA_STS_CLIENT_SECRET_STAD=

# Attest-utfärdande: Svadas utfärdare (compose.dsga.yml,
# samordningsrollen) signerar medlems- och deltagarintygen åt DHI och Staden.
# Varje organisation myntar själv sitt eget rollintyg. Intygen utbyts via den
# delade Docker-volymen nedan (se SvadaParticipantBootstrapExtension.java,
# "ATTEST-UTFÄRDANDE").
SVADA_DATASPACE_ID=svada-poc2
SVADA_ROLLINNEHAVARE_DHI="DHI – dataleverantör"
# Delad Docker-namngiven volym (svada-vc-utbyte, skapas en gång manuellt,
# se compose.dhi.yml/compose.stad.yml) - läses/skrivs INTE över REST/API-
# nyckel eftersom IdentityHubs Identity-API-nycklar genereras slumpmässigt
# vid varje uppstart och varje containers Vault är process-lokal (DHI har
# varken tillgång till eller behov av Stadens privata nyckelmaterial).
SVADA_VC_UTBYTE_DIR=/vc-utbyte

# AES-krypteringsalias för IdentityHubs ParticipantContextConfigService
# (den krypterar "sensitive config" med AES som DEFAULT-algoritm - se den
# fulla motiveringen i SvadaParticipantBootstrapExtension.java). SAMMA
# alias måste läsas av både uppströms AesEncryptionExtension (som
# registrerar "aes"-algoritmen) och vår egen bootstrap-extension (som
# seedar själva AES-nyckeln i vaulten) - en enda sanningskälla här löser
# det, i stället för att duplicera strängen på två ställen. Samma värde
# för DHI och Stad är helt ofarligt: varje instans har sin egen,
# in-memory vault, ingen delad hemlighet mellan parterna.
IDENTITY_HUB_AES_KEY_ALIAS=svada-participants-aes-key

# ----- Skördarna (harvester-se + harvester-eu) -----
# Cron-intervallet i BÅDA skördarna. 30 s är PoC-takt (riktiga portaler
# skördar per dygn) – kort nog att testfall 6a.6 kan vänta in en schemalagd
# skörd, långt nog att loggen går att läsa.
# Fördröjning före FÖRSTA skörden – källan kan behöva komma upp först.
# Skördekällorna. harvester-se når CKAN över dsp-public (containernamn),
# harvester-eu når harvester-se över portalernas eget nät. Kedjan är
# transitiv: CKAN -> harvester-se -> harvester-eu.

# ----- Dashboarden (kontrollrummet, komponent 14) -----
# Dashboarden når ALLA komponenter över VÄRDENS publicerade portar (samma
# endpoints en människa skulle curla), inte över de interna org-näten. Kontrollrummet ska inte kunna se något som
# inte redan är exponerat, och fcf-sim får aldrig hamna på dsp-public
# (verify_ap4c.sh 4c.x). host.docker.internal pekas till värdens gateway
# med extra_hosts i compose.kontrollrum.yml.
DASH_VARD=host.docker.internal
# Hur ofta kontrollrummet pollar komponenternas hälsa (bakgrundstråd).
DASH_HALSA_INTERVALL_S=10
# Timeout per anrop mot en komponent. Kort: en död komponent ska visas som
# röd snabbt, inte hänga vyn.
DASH_TIMEOUT_S=8
# Avvikelsevyn: hur ofta mätfönstret (orion-dhi) pollas, hur många punkter
# som hålls (576 = två dygn av 5-minutersserien, samma som fcf-sim) och
# vilken RELATIV avvikelse mellan mätt och modellerat bräddflöde som ska
# larma. 0.5 = 50 %; avvikelseläget ger faktor 5 (=400 %).
# Förstärkning kontrollrummets avvikelseknapp begär av simulatorn. Avvikelselägets
# default är 5; 20 krävs för att slå igenom mot dygnets MODELLERADE topp
# oavsett var i uppspelningen serien står (avvikelselägets logik).
# Minsta antal mätpunkter innan larmet får slå (ensidigt larm – ett tunt
# fönster kan bara underskatta toppen, aldrig överskatta den).
# Brunnen som avvikelsevyn följer (den enda med riktig mätserie).
DASH_BRUNN_ID=urn:ngsi-ld:SewerOverflowModelB:SSO1_01-4526
# Hur många auditposter som hålls i minnet.
DASH_AUDIT_RETENTION=300

# ----- WATERVERSE FAIR-lager (profil "fair", TIMEBOXAD) -----
# FAIR-tjänsten och FAIRness-evaluatorn (HISTORIK, ingår inte i Svada-mini).
# LICENS: FAIRness Evaluator saknar helt
# licensfil och licensomnämnande. Källkoden vendoreras därför ALDRIG in i
# detta repo – den klonas lokalt på en PINNAD commit och byggs. mqa-scoring
# är MIT (HISTORIK: katalogen finns inte i Svada-mini).
# Upstreams Dockerfile kör "FROM python:3.8" (rörlig tagg, regeln om låsta taggar).
# Vi bygger med egen Dockerfile och låst tagg. 3.8 krävs: requirements.txt
# pinnar pyproj==3.4.1, som inte har hjul för nyare Python.
# MQA: data.europa.eu:s egen SHACL-validator (30 poäng av 405). "edp" =
# fråga den riktiga tjänsten, "lokal" = kör pyshacl mot ckan/shapes.
# Vid nätverksfel faller edp-läget tillbaka på lokal och redovisar det.
# Timeout mot externa vokabulärer/validatorn. MQA:s metrikfunktioner hämtar
# EU-vokabulärer över nätet; en avskuren miljö ger 0 poäng med motivering.

# ----- Bas för egna Python-tjänster -----
PYTHON_IMAGE=python:3.12.15-slim

# =====================================================================
# LOKALA DUMMY-LÖSENORD (endast PoC – ej riktiga hemligheter)
# =====================================================================
TIMESCALE_PASSWORD=
